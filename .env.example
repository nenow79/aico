OPENROUTER_API_KEY=
LITELLM_API_KEY=
# Ustaw prawdziwy klucz wyłącznie lokalnie w .env lub środowisku.
BMF_API_KEY=
BMF_BASE_URL=https://aoai-farm.bosch-temp.com/api
BMF_API_VERSION=2025-04-01-preview
LITELLM_URL=https://litellm.orchestration.bbm.ai.bosch.com/v1/chat/completions
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Firmowy CA w formacie PEM; nie wyłączaj weryfikacji TLS.
# REQUESTS_CA_BUNDLE=C:/certs/company-ca.pem
# SSL_CERT_FILE=C:/certs/company-ca.pem
# Domyślnie LiteLLM/BMF: 120 s, OpenRouter: 10 s. Odkomentuj dla wspólnego override.
# LLM_CONNECT_TIMEOUT=120
LLM_READ_TIMEOUT=120
LLM_RETRIES=2
MCP_INIT_TIMEOUT=10
MCP_DISCOVERY_TIMEOUT=15
MCP_CALL_TIMEOUT=60
# 1 wymaga przygotowanego cache tiktoken (pierwsze użycie może pobierać słownik).
AICO_EXACT_TOKENS=0
